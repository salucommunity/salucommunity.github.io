{
  "name": "SALU Community",
  "short_name": "SALU Community",
  "description": "Admissions, merit lists, fee structure, seats, past papers and free mock tests for Shah Abdul Latif University, Khairpur students.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0a3d91",
  "lang": "en",
  "categories": [
    "education"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Merit List",
      "url": "./merit-list.html"
    },
    {
      "name": "Past Papers",
      "url": "./past-papers.html"
    },
    {
      "name": "Aggregate Calculator",
      "url": "./aggregate-calculator.html"
    },
    {
      "name": "Announcements",
      "url": "./announcements.html"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://salucommunity.github.io/manifest.webmanifest"
    }
  ]
}
